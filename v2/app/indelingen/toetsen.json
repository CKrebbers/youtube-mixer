{
  "schema": 1,
  "naam": "standaard",
  "apparaat": "toetsen",
  "uitleg": "Linkerhand op de track met focus ({focus}); 1-8 kiezen de focus. Shift = de variant (op de maat, wissen, grof). Niets met Cmd/Ctrl/Alt en niets tijdens typen.",
  "regels": [
    { "control": "Digit{k}", "actie": "track.{k}.focus", "gedrag": "trigger", "label": "focus op track" },
    { "control": "KeyQ", "actie": "track.{focus}.play", "gedrag": "trigger", "label": "play" },
    { "control": "KeyQ", "shift": true, "actie": "track.{focus}.play.quant", "gedrag": "trigger", "label": "op de maat" },
    { "control": "KeyW", "actie": "track.{focus}.cue", "gedrag": "trigger", "label": "cue" },
    { "control": "KeyE", "actie": "track.{focus}.sync", "gedrag": "trigger", "label": "sync" },
    { "control": "KeyE", "shift": true, "actie": "track.{focus}.sync.klok", "gedrag": "trigger", "label": "klok naar dit nummer" },
    { "control": "KeyR", "actie": "track.{focus}.beatjump.terug", "gedrag": "trigger", "label": "beatjump terug" },
    { "control": "KeyT", "actie": "track.{focus}.beatjump.voor", "gedrag": "trigger", "label": "beatjump vooruit" },
    { "control": "KeyR", "shift": true, "actie": "track.{focus}.loop.halveer", "gedrag": "trigger", "label": "loop halveren" },
    { "control": "KeyT", "shift": true, "actie": "track.{focus}.loop.verdubbel", "gedrag": "trigger", "label": "loop verdubbelen" },
    { "control": "KeyA", "actie": "track.{focus}.hotcue.1", "gedrag": "trigger", "label": "hotcue 1" },
    { "control": "KeyS", "actie": "track.{focus}.hotcue.2", "gedrag": "trigger", "label": "hotcue 2" },
    { "control": "KeyD", "actie": "track.{focus}.hotcue.3", "gedrag": "trigger", "label": "hotcue 3" },
    { "control": "KeyF", "actie": "track.{focus}.hotcue.4", "gedrag": "trigger", "label": "hotcue 4" },
    { "control": "KeyA", "shift": true, "actie": "track.{focus}.hotcue.1.wis", "gedrag": "trigger", "label": "hotcue 1 wissen" },
    { "control": "KeyS", "shift": true, "actie": "track.{focus}.hotcue.2.wis", "gedrag": "trigger", "label": "hotcue 2 wissen" },
    { "control": "KeyD", "shift": true, "actie": "track.{focus}.hotcue.3.wis", "gedrag": "trigger", "label": "hotcue 3 wissen" },
    { "control": "KeyF", "shift": true, "actie": "track.{focus}.hotcue.4.wis", "gedrag": "trigger", "label": "hotcue 4 wissen" },
    { "control": "KeyG", "actie": "track.{focus}.loop", "gedrag": "trigger", "label": "loop aan/uit" },
    { "control": "KeyZ", "actie": "track.{focus}.nudge.terug", "gedrag": "trigger", "label": "nudge trager" },
    { "control": "KeyX", "actie": "track.{focus}.nudge.voor", "gedrag": "trigger", "label": "nudge sneller" },
    { "control": "KeyC", "actie": "track.{focus}.pfl", "gedrag": "schakelaar", "label": "koptelefoon" },
    { "control": "KeyV", "actie": "track.{focus}.kant", "gedrag": "trigger", "label": "kant A → B → thru" },
    { "control": "KeyJ", "actie": "track.{focus}.kill.laag", "gedrag": "trigger", "label": "bas weg" },
    { "control": "KeyK", "actie": "track.{focus}.kill.mid", "gedrag": "trigger", "label": "mid weg" },
    { "control": "KeyL", "actie": "track.{focus}.kill.hoog", "gedrag": "trigger", "label": "hoog weg" },
    { "control": "Comma", "actie": "klok.tempo.neer", "gedrag": "trigger", "label": "klok −0,1" },
    { "control": "Period", "actie": "klok.tempo.op", "gedrag": "trigger", "label": "klok +0,1" },
    { "control": "Comma", "shift": true, "actie": "klok.tempo.neer.grof", "gedrag": "trigger", "label": "klok −1" },
    { "control": "Period", "shift": true, "actie": "klok.tempo.op.grof", "gedrag": "trigger", "label": "klok +1" },
    { "control": "Slash", "actie": "klok.tap", "gedrag": "trigger", "label": "tap tempo" },
    { "control": "ArrowUp", "actie": "library.vorige", "gedrag": "trigger", "label": "library omhoog" },
    { "control": "ArrowDown", "actie": "library.volgende", "gedrag": "trigger", "label": "library omlaag" },
    { "control": "Enter", "actie": "library.laad", "gedrag": "trigger", "label": "laad op de focus-track" }
  ]
}
