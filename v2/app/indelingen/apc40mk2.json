{
  "schema": 1,
  "naam": "standaard",
  "apparaat": "apc40mk2",
  "shift": "shift",
  "uitleg": "Eén kolom = één track (knop boven: filter, fader onder). Rechts de track met focus. Vijf grid-standen op scene 1-5 (hotcues 1-4, hotcues 5-8, kills en beatjump, stems, patronen), drie knoppenstanden op Clip/Device View en Detail View. {k} = kolom 1-8, {focus} = de track met focus.",
  "regels": [
    { "control": "fader{k}", "actie": "track.{k}.fader", "gedrag": "absoluut", "label": "volume" },
    { "control": "tk{k}", "actie": "track.{k}.filter", "gedrag": "eindeloos", "led": { "ring": "pan" }, "label": "filter" },
    { "control": "act{k}", "actie": "track.{k}.play", "gedrag": "trigger", "led": { "tel": "aan" }, "label": "play" },
    { "control": "act{k}", "shift": true, "actie": "track.{k}.play.quant", "gedrag": "trigger", "label": "op de maat" },
    { "control": "solo{k}", "actie": "track.{k}.sync", "gedrag": "trigger", "label": "sync" },
    { "control": "solo{k}", "shift": true, "actie": "track.{k}.sync.klok", "gedrag": "trigger", "label": "klok naar dit nummer" },
    { "control": "ab{k}", "actie": "track.{k}.kant", "gedrag": "trigger", "led": { "kleur": { "uit": "geel", "half": "uit", "aan": "oranje" } }, "label": "kant A → B → thru" },
    { "control": "rec{k}", "actie": "track.{k}.pfl", "gedrag": "schakelaar", "label": "koptelefoon" },
    { "control": "rec{k}", "shift": true, "actie": "track.{k}.cue", "gedrag": "trigger", "label": "cue" },
    { "control": "sel{k}", "actie": "track.{k}.focus", "gedrag": "trigger", "label": "focus" },
    { "control": "stop{k}", "actie": "track.{k}.loop", "gedrag": "trigger", "led": { "tel": "aan" }, "label": "loop aan/uit" },

    { "control": "pad5-{k}", "actie": "track.{k}.hotcue.1", "gedrag": "trigger", "led": { "kleur": "geel" }, "label": "hotcue 1" },
    { "control": "pad4-{k}", "actie": "track.{k}.hotcue.2", "gedrag": "trigger", "led": { "kleur": "geel" }, "label": "hotcue 2" },
    { "control": "pad3-{k}", "actie": "track.{k}.hotcue.3", "gedrag": "trigger", "led": { "kleur": "geel" }, "label": "hotcue 3" },
    { "control": "pad2-{k}", "actie": "track.{k}.hotcue.4", "gedrag": "trigger", "led": { "kleur": "geel" }, "label": "hotcue 4" },
    { "control": "pad5-{k}", "shift": true, "actie": "track.{k}.hotcue.1.wis", "gedrag": "trigger", "led": { "kleur": "rood" }, "label": "hotcue 1 wissen" },
    { "control": "pad4-{k}", "shift": true, "actie": "track.{k}.hotcue.2.wis", "gedrag": "trigger", "led": { "kleur": "rood" }, "label": "hotcue 2 wissen" },
    { "control": "pad3-{k}", "shift": true, "actie": "track.{k}.hotcue.3.wis", "gedrag": "trigger", "led": { "kleur": "rood" }, "label": "hotcue 3 wissen" },
    { "control": "pad2-{k}", "shift": true, "actie": "track.{k}.hotcue.4.wis", "gedrag": "trigger", "led": { "kleur": "rood" }, "label": "hotcue 4 wissen" },
    { "control": "pad1-{k}", "actie": "track.{k}.kill.laag", "gedrag": "trigger", "led": { "kleur": { "aan": "rood", "uit": "rooddonker" } }, "label": "bas weg" },

    { "control": "pad5-{k}", "laag": "grid.cue58", "actie": "track.{k}.hotcue.5", "gedrag": "trigger", "led": { "kleur": "oranje" }, "label": "hotcue 5" },
    { "control": "pad4-{k}", "laag": "grid.cue58", "actie": "track.{k}.hotcue.6", "gedrag": "trigger", "led": { "kleur": "oranje" }, "label": "hotcue 6" },
    { "control": "pad3-{k}", "laag": "grid.cue58", "actie": "track.{k}.hotcue.7", "gedrag": "trigger", "led": { "kleur": "oranje" }, "label": "hotcue 7" },
    { "control": "pad2-{k}", "laag": "grid.cue58", "actie": "track.{k}.hotcue.8", "gedrag": "trigger", "led": { "kleur": "oranje" }, "label": "hotcue 8" },
    { "control": "pad5-{k}", "laag": "grid.cue58", "shift": true, "actie": "track.{k}.hotcue.5.wis", "gedrag": "trigger", "led": { "kleur": "rood" }, "label": "hotcue 5 wissen" },
    { "control": "pad4-{k}", "laag": "grid.cue58", "shift": true, "actie": "track.{k}.hotcue.6.wis", "gedrag": "trigger", "led": { "kleur": "rood" }, "label": "hotcue 6 wissen" },
    { "control": "pad3-{k}", "laag": "grid.cue58", "shift": true, "actie": "track.{k}.hotcue.7.wis", "gedrag": "trigger", "led": { "kleur": "rood" }, "label": "hotcue 7 wissen" },
    { "control": "pad2-{k}", "laag": "grid.cue58", "shift": true, "actie": "track.{k}.hotcue.8.wis", "gedrag": "trigger", "led": { "kleur": "rood" }, "label": "hotcue 8 wissen" },

    { "control": "pad5-{k}", "laag": "grid.klank", "actie": "track.{k}.kill.hoog", "gedrag": "trigger", "led": { "kleur": { "aan": "rood", "uit": "rooddonker" } }, "label": "hoog weg" },
    { "control": "pad4-{k}", "laag": "grid.klank", "actie": "track.{k}.kill.mid", "gedrag": "trigger", "led": { "kleur": { "aan": "rood", "uit": "rooddonker" } }, "label": "mid weg" },
    { "control": "pad3-{k}", "laag": "grid.klank", "actie": "track.{k}.kill.laag", "gedrag": "trigger", "led": { "kleur": { "aan": "rood", "uit": "rooddonker" } }, "label": "bas weg" },
    { "control": "pad2-{k}", "laag": "grid.klank", "actie": "track.{k}.beatjump.terug", "gedrag": "trigger", "led": { "kleur": "cyaan" }, "label": "beatjump terug" },
    { "control": "pad1-{k}", "laag": "grid.klank", "actie": "track.{k}.beatjump.voor", "gedrag": "trigger", "led": { "kleur": "cyaan" }, "label": "beatjump vooruit" },
    { "control": "pad2-{k}", "laag": "grid.klank", "shift": true, "actie": "track.{k}.loop.halveer", "gedrag": "trigger", "led": { "kleur": "cyaan" }, "label": "loop halveren" },
    { "control": "pad1-{k}", "laag": "grid.klank", "shift": true, "actie": "track.{k}.loop.verdubbel", "gedrag": "trigger", "led": { "kleur": "cyaan" }, "label": "loop verdubbelen" },

    { "control": "scene1", "actie": "laag:grid", "gedrag": "trigger", "led": { "kleur": "geel" }, "label": "grid: hotcues 1-4" },
    { "control": "scene2", "actie": "laag:grid.cue58", "gedrag": "trigger", "led": { "kleur": "oranje" }, "label": "grid: hotcues 5-8" },
    { "control": "scene3", "actie": "laag:grid.klank", "gedrag": "trigger", "led": { "kleur": "magenta" }, "label": "grid: kills en beatjump" },
    { "control": "scene4", "actie": "laag:grid.stems", "gedrag": "trigger", "led": { "kleur": "zeegroen" }, "label": "grid: stems weg" },
    { "control": "scene5", "actie": "laag:grid.patronen", "gedrag": "trigger", "led": { "kleur": "violet" }, "label": "grid: patronen" },

    { "control": "dk1", "actie": "track.{focus}.trim", "gedrag": "eindeloos", "led": { "ring": "pan" }, "label": "trim" },
    { "control": "dk2", "actie": "track.{focus}.hoog", "gedrag": "eindeloos", "led": { "ring": "pan" }, "label": "hoog" },
    { "control": "dk3", "actie": "track.{focus}.mid", "gedrag": "eindeloos", "led": { "ring": "pan" }, "label": "mid" },
    { "control": "dk4", "actie": "track.{focus}.laag", "gedrag": "eindeloos", "led": { "ring": "pan" }, "label": "laag" },
    { "control": "dk5", "actie": "track.{focus}.send.a", "gedrag": "eindeloos", "label": "echo" },
    { "control": "dk6", "actie": "track.{focus}.send.b", "gedrag": "eindeloos", "label": "galm" },
    { "control": "dk7", "actie": "track.{focus}.fx.mix", "gedrag": "eindeloos", "label": "effect mix" },
    { "control": "dk8", "actie": "track.{focus}.fx.knop.1", "gedrag": "eindeloos", "label": "effect knop 1" },
    { "control": "dk{k}", "laag": "device.rack", "actie": "track.{focus}.fx.knop.{k}", "gedrag": "eindeloos", "label": "effect knop" },
    { "control": "dk{k}", "laag": "device.echo", "actie": "send.a.knop.{k}", "gedrag": "eindeloos", "label": "echo knop" },
    { "control": "dk{k}", "laag": "device.galm", "actie": "send.b.knop.{k}", "gedrag": "eindeloos", "label": "galm knop" },
    { "control": "clipdev", "actie": "laag:device.rack", "gedrag": "schakelaar", "led": { "kleur": "wit" }, "label": "knoppen: effect" },
    { "control": "detail", "actie": "laag:device.echo", "gedrag": "schakelaar", "led": { "kleur": "wit" }, "label": "knoppen: echo" },
    { "control": "detail", "shift": true, "actie": "laag:device.galm", "gedrag": "schakelaar", "led": { "kleur": "wit" }, "label": "knoppen: galm" },
    { "control": "devL", "actie": "track.{focus}.fx.vorig", "gedrag": "trigger", "label": "vorig effect" },
    { "control": "devR", "actie": "track.{focus}.fx.volgend", "gedrag": "trigger", "label": "volgend effect" },
    { "control": "devOn", "actie": "track.{focus}.fx.aan", "gedrag": "schakelaar", "label": "effect aan/uit" },

    { "control": "bankL", "actie": "track.{focus}.beatjump.terug", "gedrag": "trigger", "label": "beatjump terug" },
    { "control": "bankR", "actie": "track.{focus}.beatjump.voor", "gedrag": "trigger", "label": "beatjump vooruit" },
    { "control": "bankL", "shift": true, "actie": "track.{focus}.loop.halveer", "gedrag": "trigger", "label": "loop halveren" },
    { "control": "bankR", "shift": true, "actie": "track.{focus}.loop.verdubbel", "gedrag": "trigger", "label": "loop verdubbelen" },
    { "control": "nudgeM", "actie": "track.{focus}.nudge.terug", "gedrag": "trigger", "label": "nudge trager" },
    { "control": "nudgeP", "actie": "track.{focus}.nudge.voor", "gedrag": "trigger", "label": "nudge sneller" },
    { "control": "play", "actie": "track.{focus}.play", "gedrag": "trigger", "led": { "tel": "aan" }, "label": "play (focus)" },
    { "control": "play", "shift": true, "actie": "track.{focus}.play.quant", "gedrag": "trigger", "label": "op de maat (focus)" },

    { "control": "tempo", "actie": "klok.tempo.op", "terug": "klok.tempo.neer", "gedrag": "trigger", "label": "klok ±0,1 bpm per tik" },
    { "control": "tempo", "shift": true, "actie": "klok.tempo.op.grof", "terug": "klok.tempo.neer.grof", "gedrag": "trigger", "label": "klok ±1 bpm per tik" },
    { "control": "tap", "actie": "klok.tap", "gedrag": "trigger", "label": "tap tempo" },
    { "control": "stopall", "shift": true, "actie": "klok.stop", "gedrag": "trigger", "label": "klok stoppen" },

    { "control": "master", "actie": "mixer.master", "gedrag": "absoluut", "label": "master" },
    { "control": "xf", "actie": "mixer.xfader", "gedrag": "absoluut", "label": "crossfader" },
    { "control": "cue", "actie": "koptelefoon.volume", "gedrag": "eindeloos", "stap": 0.015625, "label": "koptelefoon volume" },
    { "control": "cue", "shift": true, "actie": "koptelefoon.mix", "gedrag": "eindeloos", "stap": 0.015625, "label": "koptelefoon mix" },

    { "control": "up", "actie": "library.vorige", "gedrag": "trigger", "label": "library omhoog" },
    { "control": "down", "actie": "library.volgende", "gedrag": "trigger", "label": "library omlaag" },
    { "control": "right", "actie": "library.laad", "gedrag": "trigger", "label": "laad op de focus-track" },
    { "control": "record", "actie": "opname", "gedrag": "trigger", "led": { "kleur": "rood" }, "label": "opname" },

    { "control": "pad5-{k}", "laag": "grid.stems", "actie": "track.{k}.stem.vocals.kill.hold", "gedrag": "trigger", "led": { "kleur": { "aan": "rood", "uit": "zeegroendonker" } }, "label": "zang weg zolang je drukt" },
    { "control": "pad5-{k}", "laag": "grid.stems", "shift": true, "actie": "track.{k}.stem.vocals.kill", "gedrag": "trigger", "led": { "kleur": { "aan": "rood", "uit": "zeegroendonker" } }, "label": "zang weg/terug (vast)" },
    { "control": "pad4-{k}", "laag": "grid.stems", "actie": "track.{k}.stem.inst.kill.hold", "gedrag": "trigger", "led": { "kleur": { "aan": "rood", "uit": "zeegroendonker" } }, "label": "rest weg zolang je drukt" },
    { "control": "pad4-{k}", "laag": "grid.stems", "shift": true, "actie": "track.{k}.stem.inst.kill", "gedrag": "trigger", "led": { "kleur": { "aan": "rood", "uit": "zeegroendonker" } }, "label": "rest weg/terug (vast)" },
    { "control": "pad3-{k}", "laag": "grid.stems", "actie": "track.{k}.stem.drums.kill.hold", "gedrag": "trigger", "led": { "kleur": { "aan": "rood", "uit": "zeegroendonker" } }, "label": "drums weg zolang je drukt" },
    { "control": "pad3-{k}", "laag": "grid.stems", "shift": true, "actie": "track.{k}.stem.drums.kill", "gedrag": "trigger", "led": { "kleur": { "aan": "rood", "uit": "zeegroendonker" } }, "label": "drums weg/terug (vast)" },
    { "control": "pad2-{k}", "laag": "grid.stems", "actie": "track.{k}.stem.bass.kill.hold", "gedrag": "trigger", "led": { "kleur": { "aan": "rood", "uit": "zeegroendonker" } }, "label": "bas weg zolang je drukt" },
    { "control": "pad2-{k}", "laag": "grid.stems", "shift": true, "actie": "track.{k}.stem.bass.kill", "gedrag": "trigger", "led": { "kleur": { "aan": "rood", "uit": "zeegroendonker" } }, "label": "bas weg/terug (vast)" },
    { "control": "pad1-{k}", "laag": "grid.stems", "actie": "track.{k}.stem.other.kill.hold", "gedrag": "trigger", "led": { "kleur": { "aan": "rood", "uit": "zeegroendonker" } }, "label": "overig weg zolang je drukt" },
    { "control": "pad1-{k}", "laag": "grid.stems", "shift": true, "actie": "track.{k}.stem.other.kill", "gedrag": "trigger", "led": { "kleur": { "aan": "rood", "uit": "zeegroendonker" } }, "label": "overig weg/terug (vast)" },

    { "control": "pad5-{k}", "laag": "grid.patronen", "actie": "track.{k}.patroon.1", "gedrag": "trigger", "led": { "kleur": "violet" }, "label": "patroon 1" },
    { "control": "pad4-{k}", "laag": "grid.patronen", "actie": "track.{k}.patroon.2", "gedrag": "trigger", "led": { "kleur": "violet" }, "label": "patroon 2" },
    { "control": "pad3-{k}", "laag": "grid.patronen", "actie": "track.{k}.patroon.3", "gedrag": "trigger", "led": { "kleur": "violet" }, "label": "patroon 3" },
    { "control": "pad2-{k}", "laag": "grid.patronen", "actie": "track.{k}.patroon.4", "gedrag": "trigger", "led": { "kleur": "violet" }, "label": "patroon 4" },
    { "control": "pad1-{k}", "laag": "grid.patronen", "actie": "track.{k}.patroon.5", "gedrag": "trigger", "led": { "kleur": "violet" }, "label": "patroon 5" },
    { "control": "stopall", "laag": "grid.patronen", "actie": "patronen.stop", "gedrag": "trigger", "led": { "kleur": "violet" }, "label": "alle patronen stoppen op de 1" }
  ]
}
